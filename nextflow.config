process.container = 'quay.io/nextflow/bash'

process {
    withName: DOWNLOAD_CHECKM2_DATABASE {
        // Use the same pinned image as the prediction tasks so this helper
        // does not depend on a compute-environment default container.
        container = 'community.wave.seqera.io/library/checkm2:1.1.0--60f287bc25d7a10d'
        cpus = 1
        memory = 8.GB
        time = 4.h
    }

    withName: CHECKM2_QC {
        container = 'community.wave.seqera.io/library/checkm2:1.1.0--60f287bc25d7a10d'
        cpus = 6
        memory = 36.GB
        time = 8.h
        maxForks = 6
        maxRetries = 5
        errorStrategy = { task.exitStatus in ((130..145) + [104, 175]) ? 'retry' : 'finish' }
    }

    withName: CHECKM2_QC_SERIAL_GENES {
        container = 'community.wave.seqera.io/library/checkm2:1.1.0--60f287bc25d7a10d'
        cpus = 6
        memory = 36.GB
        time = 8.h
        maxForks = 6
        maxRetries = 5
        errorStrategy = { task.exitStatus in ((130..145) + [104, 175]) ? 'retry' : 'finish' }
    }

    withName: MERGE_CHECKM2_REPORTS {
        cpus = 1
        memory = 2.GB
        time = 1.h
    }
}
